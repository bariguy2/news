# Optional: paste the Session pooler connection URI from Supabase Dashboard > Connect.
# Keep this line commented to use the local SQLite database instead.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres

# Hosted mode is the default. Start with free-tier provider accounts.
SUMMARY_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
# Alternative local mode: SUMMARY_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b

# These are list-price-equivalent safeguards, NOT charges or paid-tier opt-ins.
# Free-tier calls count against these too. Keep provider accounts on free tiers.
# Zero blocks hosted calls for that scope. Limits reset each UTC calendar month.
AI_MONTHLY_BUDGET_USD=5
AI_EVAL_MONTHLY_BUDGET_USD=1
AI_TIMEOUT_SECONDS=60
AI_MAX_ATTEMPTS=2
PIPELINE_CONCURRENCY=3
AUTO_SUMMARY_LIMIT=0
# Total generated token caps include reasoning, which is never displayed.
GROQ_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_OUTPUT_TOKENS=2048
OLLAMA_MAX_OUTPUT_TOKENS=512
# Explicit prices are required when using a model other than the defaults.
# GROQ_INPUT_USD_PER_MILLION=0.15
# GROQ_OUTPUT_USD_PER_MILLION=0.60
# GEMINI_INPUT_USD_PER_MILLION=0.30
# GEMINI_OUTPUT_USD_PER_MILLION=2.50
